# Copy to .env and fill the values
MONGO_URI=mongodb://localhost:27017/moverecife
PORT=3000

# ThingSpeak (where your ESP32 posts): set CHANNEL_ID and (optional) READ_API_KEY
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID
THINGSPEAK_READ_API_KEY=

# Optional: timezone for ETA calculations (e.g. America/Recife)
TIMEZONE=America/Recife
